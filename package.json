{
  "name": "dsh-persona-innate",
  "version": "0.5.6",
  "description": "DSH 自主成长拟人插件：先天画像 + 六层记忆（raw_turns/events/facts/self_model/state/索引）+ provenance 防线 + 指令剥离 + 按意图装配（shadow）+ 状态机/复盘 + procedures 程序性记忆 + salience 分级 + goldset 评测",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:only": "node --test tests/*.test.mjs",
    "audit": "node scripts/audit-capabilities.mjs",
    "audit:write": "node scripts/audit-capabilities.mjs --write",
    "audit:extract": "node scripts/audit-extraction.mjs",
    "eval:goldset": "node scripts/eval-goldset.mjs"
  },
  "keywords": [
    "dsh",
    "persona",
    "memory",
    "companion"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
